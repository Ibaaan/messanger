{
  "Jwt": {
    "Issuer": "https://messanger.local",
    "Audience": "messanger-api"
  },
  "HttpSecurity": {
    "AllowedOrigins": [],
    "TrustedProxies": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "RefreshTokenCleanup": {
    "Enabled": true,
    "Interval": "1.00:00:00",
    "BatchSize": 1000,
    "MaximumBatchesPerRun": 10
  }
}
